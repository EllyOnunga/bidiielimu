# ─────────────────────────────────────────────
# ElimuHub — Backend Environment Configuration
# ─────────────────────────────────────────────

# ── Core Django Settings ──
DEBUG=False
SECRET_KEY=generate-a-secure-random-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.elimuhub.com

# ── Database Configuration ──
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://user:password@localhost:5432/elimuhubdb
DATABASE_READ_URL=postgres://user:password@localhost:5432/elimuhubdb

# ── Multi-Tenancy (django-tenants) ──
TENANT_DOMAIN_SUFFIX=elimuhub.com
TENANT_SUBFOLDER_PREFIX=school

# ── Email Configuration (SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@elimuhub.com

# ── Redis & Caching ──
REDIS_URL=redis://localhost:6379/0

# ── Sentry Error Tracking ──
SENTRY_DSN=your-sentry-dsn-here
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── JWT Auth ──
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Social Authentication (Google) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Payment Integration (M-Pesa) ──
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-stk-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/fees/mpesa-callback/

# ── SMS Gateway (Africa's Talking) ──
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key

# ── External URLs ──
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
