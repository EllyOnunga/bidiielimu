# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1255, pipenv should generally have its out-of-code-folders
#   (.venv) ignored, or check them in:
# .venv
#  In some cases, you may want to ignore Pipfile.lock too:
# Pipfile.lock

# poetry
#   Similar to pipenv, poetry should generally have its virtualenv ignored:
# .venv

# pdm
#   Similar to pipenv, pdm should generally have its .pdm-python ignored:
# .pdm-python
#   pdm-lock.dev.txt is a developer-only file:
# pdm-lock.dev.txt

# PEP 582; used by e.g. github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

