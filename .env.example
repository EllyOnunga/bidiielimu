# Database Settings
DB_NAME=elimuhub
DB_USER=elimuhub_admin
DB_PASSWORD=***REDACTED***
DB_HOST=pgbouncer
DB_PORT=6432

# Redis
REDIS_URL=redis://redis:6379/0

# Django Settings
DEBUG=True
SECRET_KEY=dev-secret-key-123
ALLOWED_HOSTS=localhost,.localhost,127.0.0.1

# Frontend URL — set to http://localhost:5173 in dev, http://localhost in prod
FRONTEND_URL=http://localhost:5173

# OpenTelemetry
OTEL_ENABLED=True

# Kafka Settings
KAFKA_CLUSTER_ID=elimuhub-cluster-id
